{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/maconair0/agentic-mcp/blob/main/agentic_mcp/manifest.schema.json",
 "title": "Controller manifest (agentic-mcp.controller/v1)",
 "description": "What one kind of SDN controller is and how each verb of the contract is done on it. Only manifest, kind and recognise are required.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "manifest",
  "kind",
  "recognise"
 ],
 "properties": {
  "manifest": {
   "enum": [
    "agentic-mcp.controller/v1"
   ],
   "description": "The format of this document"
  },
  "kind": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$",
   "description": "A short lower-case name for this kind of controller"
  },
  "title": {
   "type": "string"
  },
  "version": {
   "type": [
    "string",
    "number"
   ]
  },
  "about": {
   "type": "string"
  },
  "domain": {
   "enum": [
    "optical",
    "packet",
    "multi-layer"
   ],
   "description": "Left out, it is worked out from the words in the API"
  },
  "recognise": {
   "type": "object",
   "additionalProperties": false,
   "anyOf": [
    {
     "required": [
      "fingerprint"
     ]
    },
    {
     "required": [
      "operation_contains"
     ]
    }
   ],
   "properties": {
    "fingerprint": {
     "type": "string",
     "description": "An address only this kind answers (a GET that returns JSON)"
    },
    "operation_contains": {
     "type": "string",
     "description": "A path only this kind's API has"
    }
   }
  },
  "api": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "openapi": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Where its API document is, if not at a usual address"
    },
    "docs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Documentation pages to read operations from"
    },
    "style": {
     "type": "string",
     "description": "How its named tools answer"
    }
   }
  },
  "defaults": {
   "type": "object",
   "description": "Arguments that have a usual value"
  },
  "operations": {
   "type": "array",
   "description": "Its operations, for a controller that publishes none",
   "items": {
    "type": "object",
    "required": [
     "method",
     "path"
    ],
    "properties": {
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE"
      ]
     },
     "path": {
      "type": "string",
      "pattern": "^/"
     },
     "summary": {
      "type": "string"
     },
     "body": {
      "type": "boolean"
     },
     "writes": {
      "type": "boolean"
     }
    }
   }
  },
  "verbs": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "read_devices",
     "read_device",
     "read_ports",
     "read_links",
     "read_hosts",
     "read_services",
     "read_service",
     "compute_path",
     "check_feasibility",
     "read_spectrum",
     "read_statistics",
     "provision",
     "teardown",
     "adjust",
     "reroute",
     "health",
     "read_alarms",
     "configure_device"
    ]
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "operation"
      ]
     },
     {
      "required": [
       "steps"
      ]
     }
    ],
    "properties": {
     "operation": {
      "type": "string",
      "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$",
      "description": "METHOD /path, with {argument} where one goes in the address"
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Several requests in order, when one is not enough",
      "items": {
       "type": "object",
       "required": [
        "operation"
       ],
       "properties": {
        "operation": {
         "type": "string",
         "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$",
         "description": "METHOD /path, with {argument} where one goes in the address"
        },
        "body": {
         "description": "The body to send, with $argument where one goes. {$int: $x}, {$num: $x}, {$str: $x}, {$add: [$x, 4096]} and {$concat: [a, $x]} compute a value.",
         "type": [
          "object",
          "array",
          "string",
          "null"
         ]
        }
       }
      }
     },
     "arguments": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "Each argument and what it is, shown to whoever is asked for it"
     },
     "body": {
      "description": "The body to send, with $argument where one goes. {$int: $x}, {$num: $x}, {$str: $x}, {$add: [$x, 4096]} and {$concat: [a, $x]} compute a value.",
      "type": [
       "object",
       "array",
       "string",
       "null"
      ]
     },
     "query": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "Query parameters: {name in the address: argument}"
     },
     "view": {
      "type": "object",
      "required": [
       "rows"
      ],
      "description": "How to read the answer as plain rows: rows is where the list is (a.b); every other key is a field and where it is in a row",
      "properties": {
       "rows": {
        "type": "string"
       }
      }
     },
     "policy": {
      "type": "object",
      "properties": {
       "max_per_hour": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "reads": {
      "type": "boolean",
      "description": "true for a POST that only reads (a path computation)"
     },
     "why": {
      "type": "string",
      "description": "A sentence shown beside it"
     }
    }
   }
  },
  "tools": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
     },
     "description": {
      "type": "string"
     },
     "schema": {
      "type": "object",
      "description": "JSON Schema of the tool's arguments"
     },
     "method": {
      "type": "string",
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE"
      ]
     },
     "path": {
      "type": "string"
     },
     "body": {
      "description": "The body to send, with $argument where one goes. {$int: $x}, {$num: $x}, {$str: $x}, {$add: [$x, 4096]} and {$concat: [a, $x]} compute a value.",
      "type": [
       "object",
       "array",
       "string",
       "null"
      ]
     },
     "query": {
      "type": "object"
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "as": {
         "type": "string"
        },
        "method": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "body": {
         "description": "The body to send, with $argument where one goes. {$int: $x}, {$num: $x}, {$str: $x}, {$add: [$x, 4096]} and {$concat: [a, $x]} compute a value.",
         "type": [
          "object",
          "array",
          "string",
          "null"
         ]
        },
        "query": {
         "type": "object"
        },
        "foreach": {
         "type": "string",
         "description": "one request per item of an earlier answer (a.b); {item} in the path"
        },
        "item": {
         "type": "string"
        },
        "optional": {
         "type": "boolean"
        },
        "timeout": {
         "type": "number"
        },
        "empty_if": {
         "type": "string",
         "description": "text in the answer that means 'nothing there yet'"
        },
        "expect": {
         "type": "object",
         "description": "what the answer has to hold, e.g. {at: a.b, all_equal: inService, say: why}"
        },
        "quiet_after": {
         "type": "array",
         "description": "refuse while a write approved here is still settling"
        },
        "error": {
         "type": "string"
        }
       }
      }
     },
     "verb": {
      "type": "string",
      "enum": [
       "read_devices",
       "read_device",
       "read_ports",
       "read_links",
       "read_hosts",
       "read_services",
       "read_service",
       "compute_path",
       "check_feasibility",
       "read_spectrum",
       "read_statistics",
       "provision",
       "teardown",
       "adjust",
       "reroute",
       "health",
       "read_alarms",
       "configure_device"
      ],
      "description": "the requests of a verb stated above"
     },
     "queue": {
      "type": "boolean",
      "description": "do not send: check, queue for a person's approval, answer with an id"
     },
     "summary": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "approve": {
      "type": "object",
      "required": [
       "token_env"
      ],
      "properties": {
       "token_env": {
        "type": "string"
       }
      },
      "description": "approve and send one queued id, for whoever holds the token in that setting"
     },
     "check": {
      "type": "object",
      "description": "rules on the arguments: between, distinct, keys, each"
     },
     "convert": {
      "type": "object",
      "description": "read an argument as a number however it is written: {dpid: number}"
     },
     "defaults": {
      "type": "object"
     },
     "reply": {
      "description": "{raw: true}, {const: ...}, {pluck: ...}, {collect: ...}, {text: [...]} or the word text",
      "type": [
       "object",
       "string"
      ]
     }
    }
   }
  },
  "catalogue": {
   "type": "object"
  },
  "provides": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "read_devices",
     "read_device",
     "read_ports",
     "read_links",
     "read_hosts",
     "read_services",
     "read_service",
     "compute_path",
     "check_feasibility",
     "read_spectrum",
     "read_statistics",
     "provision",
     "teardown",
     "adjust",
     "reroute",
     "health",
     "read_alarms",
     "configure_device"
    ]
   },
   "description": "Which named tool serves which verb"
  },
  "skill": {
   "type": "string"
  },
  "replay": {
   "type": "object",
   "properties": {
    "when_new_in": {
     "type": "string"
    },
    "every_s": {
     "type": "number"
    }
   },
   "description": "Send again what was approved when something new appears in this read"
  },
  "quirks": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "What its API does not say and use has shown, one sentence each"
  },
  "limits": {
   "type": "object",
   "description": "Limits in words, for people"
  },
  "guide": {
   "type": "string",
   "description": "Prose about working with it"
  },
  "not_carried_over": {
   "type": "array"
  }
 }
}