{
 "about": "The contract every controller is checked against at onboarding. It is split into domains of work. Each domain lists the verbs that belong to it. A verb says which HTTP methods may serve it and which words in an operation's path count for or against it. A controller is accepted when every required domain that applies to its layer has at least one verb it can serve.",
 "version": 1,
 "accept": "every required domain that applies has at least one verb served",
 "domains": [
  {
   "name": "inventory",
   "required": true,
   "why": "know what is in the network",
   "verbs": {
    "read_devices": {
     "why": "what is in the domain",
     "methods": [
      "GET"
     ],
     "for": {
      "/devices": 6,
      "/switches": 6,
      "portmapping:network": 5,
      "/nodes": 4,
      "network-topology:network-topology": 2,
      "inventory": 2
     },
     "against": [
      "ports",
      "stat",
      "region",
      "cluster",
      "_ids",
      "desc"
     ],
     "tool": "list_devices",
     "help": "the equipment itself: devices, boxes, inventory, switches, routers, transponders, ROADMs",
     "words": "\\b(devices?|switch(es)?|nodes?|routers?|transponders?|roadms?|inventory|equipment)\\b",
     "words_rank": 15,
     "examples": [
      "what boxes does it have"
     ]
    },
    "read_device": {
     "why": "one device in detail",
     "methods": [
      "GET"
     ],
     "one": true,
     "for": {
      "/devices/{": 6,
      "/device/{": 6,
      "/stats/desc/{": 5,
      "portmapping:network/nodes={": 5,
      "/switches/{": 4
     },
     "against": [
      "ports",
      "stat",
      "flows",
      "portstate",
      "/nodes={node-id}/",
      "mapping",
      "region"
     ],
     "tool": "get_device",
     "help": "one named device in detail"
    },
    "read_ports": {
     "why": "the ports of a device",
     "methods": [
      "GET"
     ],
     "one": true,
     "for": {
      "/devices/{id}/ports": 7,
      "/portdesc/{": 6,
      "/ports": 3,
      "/mapping": 3
     },
     "against": [
      "stat",
      "statistics",
      "portstate",
      "modulation"
     ],
     "tool": "list_ports",
     "help": "the list of ports of one named device",
     "words": "\\bports?\\b",
     "words_rank": 12
    }
   }
  },
  {
