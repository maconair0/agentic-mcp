 ],
 "verb_fields": {
  "why": "what the verb is for (shown in reports)",
  "methods": "HTTP methods that may serve it",
  "for": "path fragments that count for an operation being this verb, with a weight",
  "against": "path fragments that count against it",
  "writes": "true for a verb that changes the network",
  "one": "true when it reads or changes one named thing",
  "tool": "the tool name it is served under: <controller key>_<tool>",
  "help": "what it means, for the small model choosing a verb from words",
  "words": "a regular expression of the words a request uses for it, read by rule before any model",
  "words_rank": "which verb's words are tried first when several match (lower first)",
  "examples": "requests in words that mean this verb, shown to the small model"
 }
}
