  {
   "name": "path computation",
   "required": false,
   "why": "find a route without committing to it",
   "verbs": {
    "compute_path": {
     "why": "a route, without committing to it",
     "methods": [
      "GET",
      "POST"
     ],
     "computes": true,
     "for": {
      "path-computation-request": 7,
      "connectivity_candidates": 6,
      "/paths/": 5,
      "compute-p-2-p-path": 3
     },
     "against": [
      "reroute",
      "delete",
      "bulk",
      "disjoint",
      "notification",
      "optimize"
     ],
     "tool": "compute_path",
     "help": "a route between two named ends",
     "words": "\\b(path|route)\\b.*\\b(between|from)\\b|\\bcompute\\b.*\\bpath\\b",
     "words_rank": 6
    },
    "check_feasibility": {
     "why": "would this service fit, without building it",
