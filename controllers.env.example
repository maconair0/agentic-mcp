# Copy to controllers.env (it is not committed). The agentic MCP reads it at
# start, and a controller is onboarded with the NAMES of the two settings that
# hold its credentials, never with the credentials themselves:
#
#   python -m agentic_mcp onboard north --url http://10.0.0.5:8181/onos/v1 \
#       --user-env NORTH_USER --password-env NORTH_PASSWORD

NORTH_USER=
NORTH_PASSWORD=

# The token that approves a queued write on a controller whose manifest asks
# for one (approve: {token_env: NAME}).
# RYU_MCP_APPROVER_TOKEN=
# TPCE_MCP_APPROVER_TOKEN=

# With this set, anything that is not a read of the service needs
# "Authorization: Bearer <token>".
# AGENTIC_MCP_TOKEN=
